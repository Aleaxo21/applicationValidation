{
  "description": "Required-field rules for the SIP Application Form (IIT). Field names correspond to legacy Word form-field names (bookmark names).",
  "placeholder_values": ["Select One", "          "],
  "sections": [
    {
      "section": "Section 1: Organisation",
      "fields": [
        {
          "name": "uen",
          "label": "Organisation Unique Entity Number (UEN)",
          "type": "text",
          "stage": "credentials",
          "validation": "uen_format"
        },
        {
          "name": "org_name",
          "label": "Organisation Name",
          "type": "text",
          "stage": "credentials",
          "min_length": 2
        },
        {"name": "org_postal", "label": "Address - Postal Code", "type": "text", "stage": "general"},
        {"name": "org_country", "label": "Address - Country", "type": "dropdown", "stage": "general"},
        {"name": "org_tel", "label": "Tel no. (Main line)", "type": "text", "stage": "general"},
        {"name": "org_type", "label": "Type of Company", "type": "dropdown", "stage": "general"},
        {"name": "biz_nature", "label": "Nature of Business", "type": "dropdown", "stage": "general"},
        {"name": "org_staff_strength", "label": "No. of Staff in Organisation", "type": "text", "numeric": true, "stage": "general"}
      ]
    },
    {
      "section": "Section 2: Main Contact",
      "fields": [
        {"name": "contact_pref", "label": "Salutation", "type": "dropdown", "stage": "general"},
        {
          "name": "contact_name",
          "label": "Main Contact - Name",
          "type": "text",
          "stage": "credentials",
          "min_length": 2
        },
        {"name": "contact_designation", "label": "Main Contact - Designation", "type": "text", "stage": "general"},
        {
          "name": "contact_email",
          "label": "Main Contact - Email address",
          "type": "text",
          "email": true,
          "stage": "credentials",
          "validation": "email_format"
        },
        {"name": "contact_tel", "label": "Main Contact - Tel no.", "type": "text", "stage": "general"}
      ]
    },
    {
      "section": "Section 4: No. of Interns Required & Job Scope",
      "fields": [
        {"name": "dip1", "label": "Diploma (row 1)", "type": "dropdown", "stage": "general"},
        {"name": "dip1_no", "label": "No. of Interns Required (row 1)", "type": "text", "numeric": true, "stage": "general"},
        {"name": "dip1_job", "label": "Job Scope / Proposed Project Title & Description (row 1)", "type": "text", "stage": "general"}
      ]
    },
    {
      "section": "Section 5: Internship Details",
      "fields": [
        {"name": "Allowance", "label": "Monthly Allowance (CPF-Exempt)", "type": "text", "numeric": true, "stage": "general"},
        {"name": "no_day_perwk", "label": "No. of Days per Week", "type": "text", "numeric": true, "stage": "general"}
      ],
      "checkbox_groups": [
        {
          "label": "Interview Requirement (at least one option must be checked)",
          "fields": ["interview_face", "interview_phone", "interview_na", "interview_remote"],
          "stage": "general"
        }
      ]
    },
    {
      "section": "Section 7: Others",
      "fields": [
        {"name": "future_engagemt", "label": "Would you like to be contacted for future engagements with TP?", "type": "dropdown", "stage": "general"}
      ]
    }
  ]
}